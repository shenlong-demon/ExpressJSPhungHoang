// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model phuser {
  id            Int             @id                 @unique  @default(autoincrement())
  name          String          @db.VarChar(255)
  phone         String          @db.VarChar(50)    @unique
  password      String
  token         String?         @db.VarChar(255)             @default(value: "")
  status        Int             @default(1)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  appKey        String?         @default(uuid())
}

model phbrand {
  id            Int             @id                 @unique @default(autoincrement())
  name          String          @db.VarChar(255)
  status        Int             @default(1)
  products      phproduct[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  appKey        String?         @default(uuid())
}

model phgroup {
  id            Int             @id                 @unique @default(autoincrement())
  name          String          @db.VarChar(255)
  status        Int             @default(1)
  products      phproduct[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  appKey        String?         @default(uuid())
}

model phproduct {
  id                Int             @id                 @unique @default(autoincrement())
  code              String?         @db.VarChar(50)
  name              String          @db.VarChar(255)
  otherName         String?         @db.VarChar(255)
  image             String?         @db.VarChar(500)
  price             Float
  basePrice         Float
  quantity          Int
  status            Int             @default(1)
  brand             phbrand          @relation(fields: [brandId], references: [id])
  brandId           Int
  group             phgroup          @relation(fields: [groupId], references: [id])
  groupId           Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  appKey            String?         @default(uuid())
  bookings          phbooking[]
  orders            phorder[]
}

model phcustomer {
    id            Int             @id                 @unique  @default(autoincrement())
    name          String          @db.VarChar(255)
    nickName      String          @db.VarChar(255)
    phone         String          @db.VarChar(50)
    image         String?         @db.VarChar(500)
    status        Int             @default(1)
    createdAt     DateTime        @default(now())
    updatedAt     DateTime        @updatedAt
    appKey        String?         @default(uuid())
    operations    phoperation[]
    bills         phbill[]
}

model phoperation {
    id            Int             @id                 @unique  @default(autoincrement())
    name          String?
    phone         String?
    note          String?
    customer      phcustomer?     @relation(fields: [customerId], references: [id])
    customerId    Int?
    employee      phemployee?     @relation(fields: [employeeId], references: [id])
    employeeId    Int?
    estimation    DateTime?
    bookings      phbooking[]
    appKey        String?         @default(uuid())
    createdAt     DateTime        @default(now())
    updatedAt     DateTime        @updatedAt
}



model phbooking {
    id            Int             @id                 @unique  @default(autoincrement())
    product       phproduct?       @relation(fields: [productId], references: [id])
    productId     Int?
    price         Float
    quantity      Int
    name          String?
    note          String?
    createdAt     DateTime        @default(now())
    updatedAt     DateTime        @updatedAt
    appKey        String?         @default(uuid())
    operation     phoperation     @relation(fields: [operationId], references: [id])
    operationId   Int
}

model phbill {
    id            Int             @id                 @unique  @default(autoincrement())
    operationId   Int
    name          String?
    phone         String?
    note          String?
    customer      phcustomer?     @relation(fields: [customerId], references: [id])
    customerId    Int?
    employee      phemployee?     @relation(fields: [employeeId], references: [id])
    employeeId    Int?
    createdAt     DateTime        @default(now())
    updatedAt     DateTime        @updatedAt
    estimation    DateTime?
    appKey        String?         @default(uuid())
    total         Float
    orders        phorder[]
    profit        Float
}


model phorder {
    id            Int             @id                 @unique  @default(autoincrement())
    bookingId     Int
    product       phproduct?       @relation(fields: [productId], references: [id])
    productId     Int?
    price         Float
    basePrice     Float
    quantity      Int
    name          String?
    note          String?
    createdAt     DateTime        @default(now())
    updatedAt     DateTime        @updatedAt
    appKey        String?         @default(uuid())
    bill          phbill          @relation(fields: [billId], references: [id])
    billId        Int
    total         Float
    profit        Float
}

model phemployee {
    id            Int             @id                 @unique  @default(autoincrement())
    name          String
    phone         String
    createdAt     DateTime        @default(now())
    updatedAt     DateTime        @updatedAt
    appKey        String?         @default(uuid())
    status        Int             @default(1)
    operations    phoperation[]
    bills         phbill[]
}
