// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


model phuser {
  id            Int             @id                 @unique  @default(autoincrement())
  name          String
  phone         String          @unique
  password      String
  token         String?         @default(value: "")
  status        Int             @default(1)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  appKey        String?         @default(uuid())
}

model phbrand {
  id            Int             @id                 @unique @default(autoincrement())
  name          String
  status        Int             @default(1)
  products      phproduct[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  appKey        String?         @default(uuid())
}

model phgroup {
  id            Int             @id                 @unique @default(autoincrement())
  name          String
  status        Int             @default(1)
  products      phproduct[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  appKey        String?         @default(uuid())
}

model phproduct {
  id                Int             @id                 @unique @default(autoincrement())
  code              String?
  name              String
  otherName         String?
  image             String?
  price             Float
  basePrice         Float
  quantity          Int
  status            Int             @default(1)
  brand             phbrand          @relation(fields: [brandId], references: [id])
  brandId           Int
  group             phgroup          @relation(fields: [groupId], references: [id])
  groupId           Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  appKey            String?         @default(uuid())
  bookings          phbooking[]
  orders            phorder[]
}

model phcustomer {
    id            Int             @id                 @unique  @default(autoincrement())
    name          String
    nickName      String
    phone         String
    image         String?
    status        Int             @default(1)
    createdAt     DateTime        @default(now())
    updatedAt     DateTime        @updatedAt
    appKey        String?         @default(uuid())
    total         Float           @default(0)
    operations    phoperation[]
    bills         phbill[]
}

model phoperation {
    id            Int             @id                 @unique  @default(autoincrement())
    name          String?
    phone         String?
    note          String?
    discount      Float             @default(0)
    customer      phcustomer?     @relation(fields: [customerId], references: [id])
    customerId    Int?
    employee      phemployee?     @relation(fields: [employeeId], references: [id])
    employeeId    Int?
    estimation    DateTime?
    bookings      phbooking[]
    issues        phoperationissue[]
    appKey        String?         @default(uuid())
    createdAt     DateTime        @default(now())
    updatedAt     DateTime        @updatedAt
}



model phbooking {
    id            Int             @id                 @unique  @default(autoincrement())
    product       phproduct?       @relation(fields: [productId], references: [id])
    productId     Int?
    price         Float
    quantity      Int
    name          String?
    note          String?
    createdAt     DateTime        @default(now())
    updatedAt     DateTime        @updatedAt
    appKey        String?         @default(uuid())
    operation     phoperation     @relation(fields: [operationId], references: [id])
    operationId   Int
}


model phoperationissue {
    id            Int             @id                 @unique  @default(autoincrement())
    note          String?
    image         String?
    createdAt     DateTime        @default(now())
    updatedAt     DateTime        @updatedAt
    appKey        String?         @default(uuid())
    operation     phoperation     @relation(fields: [operationId], references: [id])
    operationId   Int
}


model phbill {
    id            Int             @id                 @unique  @default(autoincrement())
    operationId   Int
    name          String?
    phone         String?
    note          String?
    discount      Float             @default(0)
    customer      phcustomer?     @relation(fields: [customerId], references: [id])
    customerId    Int?
    employee      phemployee?     @relation(fields: [employeeId], references: [id])
    employeeId    Int?
    createdAt     DateTime        @default(now())
    updatedAt     DateTime        @updatedAt
    estimation    DateTime?
    appKey        String?         @default(uuid())
    total         Float
    orders        phorder[]
    issues        phbillissue[]
    profit        Float
}


model phorder {
    id            Int             @id                 @unique  @default(autoincrement())
    bookingId     Int
    product       phproduct?       @relation(fields: [productId], references: [id])
    productId     Int?
    price         Float
    basePrice     Float
    quantity      Int
    name          String?
    note          String?
    createdAt     DateTime        @default(now())
    updatedAt     DateTime        @updatedAt
    appKey        String?         @default(uuid())
    bill          phbill          @relation(fields: [billId], references: [id])
    billId        Int
    total         Float
    profit        Float
}


model phbillissue {
    id                      Int             @id                 @unique  @default(autoincrement())
    operationIssueId        Int
    note                    String?
    image                   String?
    createdAt               DateTime        @default(now())
    updatedAt               DateTime        @updatedAt
    appKey                  String?         @default(uuid())
    bill                    phbill          @relation(fields: [billId], references: [id])
    billId                  Int
}


model phemployee {
    id            Int             @id                 @unique  @default(autoincrement())
    name          String
    phone         String
    createdAt     DateTime        @default(now())
    updatedAt     DateTime        @updatedAt
    appKey        String?         @default(uuid())
    status        Int             @default(1)
    operations    phoperation[]
    bills         phbill[]
}
